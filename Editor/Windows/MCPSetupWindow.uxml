<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="Components/Common.uss" />
    <Style src="Adjoint/Adjoint.uss" />
    <Style src="MCPSetupWindow.uss" />
    <ui:VisualElement class="adjoint-root">
    <ui:ScrollView name="root-container" mode="Vertical">
        <ui:Label text="Adjoint Setup" name="title" class="title" />

        <!-- Tips Section -->
        <ui:VisualElement class="section">
            <ui:Label text="Adjoint Best Practices" class="section-title setup-heading" />
            <ui:VisualElement class="section-content">
                <ui:VisualElement class="setting-row tip-row">
                    <ui:Label text="1. Use Auto Models" class="setting-label tip-label" />
                    <ui:Label text="Routes to the cheapest model for the job" class="setting-value tip-detail" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row tip-row">
                    <ui:Label text="2. Be Specific" class="setting-label tip-label" />
                    <ui:Label text="Say what, where, and how you want it changed" class="setting-value tip-detail" />
                </ui:VisualElement>
                <ui:VisualElement class="setting-row tip-row">
                    <ui:Label text="3. @context" class="setting-label tip-label-context" />
                    <ui:Label text="Reference any file in your project with @" class="setting-value tip-detail" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Action Buttons -->
        <ui:VisualElement class="button-container">
            <ui:Button name="done-button" text="Done" class="setup-button action-button" />
        </ui:VisualElement>
    </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
