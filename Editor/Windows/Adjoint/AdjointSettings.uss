/* Adjoint Settings Window Styles */

/* Scroll area */
.settings-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Section spacing */
.settings-section {
    margin: 6px 8px;
}

.settings-section .section-content {
    padding: 10px 14px;
}

/* Description text under toggles */
.setting-description {
    font-size: 9px;
    color: #4B4B4B;
    margin-top: -2px;
    margin-bottom: 8px;
    margin-left: 0;
    padding-left: 0;
}

/* Logout button */
.settings-logout-button {
    margin-top: 8px;
    height: 26px;
}

/* Open Chat button - full width primary style */
.settings-action-button {
    width: 100%;
    height: 28px;
}
