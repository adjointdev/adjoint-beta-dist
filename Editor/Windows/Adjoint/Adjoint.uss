/* Adjoint Editor Window Styles - Professional IDE Aesthetic */
/* High-Zinc / Deep Obsidian Palette */

/* Root Container */
.adjoint-root {
    flex-grow: 1;
    padding: 0;
    background-color: #0B0B0B;
}

/* Content Width Constraint */
.content-wrapper {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    padding: 0 8px;
    overflow: hidden;
    min-height: 0;
}

/* Header */
.adjoint-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    background-color: #121212;
    border-bottom-width: 1px;
    border-bottom-color: #242424;
    min-height: 36px;
    flex-shrink: 0;
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.header-center {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.header-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.header-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #858585;
    margin-left: 4px;
    letter-spacing: 1px;
}

.header-subtitle {
    font-size: 12px;
    color: #6B6B6B;
    letter-spacing: 0.5px;
}

.header-logo {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Legacy title styles (kept for compatibility) */
.adjoint-title {
    font-size: 17px;
    -unity-font-style: bold;
    color: #E4E4E4;
    letter-spacing: 1px;
}

.adjoint-subtitle {
    font-size: 12px;
    color: #6B6B6B;
}

.active-badge {
    flex-direction: row;
    align-items: center;
    background-color: rgba(88, 101, 242, 0.1);
    border-radius: 3px;
    border-width: 1px;
    border-color: #242424;
    padding: 3px 8px;
    margin-right: 8px;
}

.active-count {
    font-size: 14px;
    -unity-font-style: bold;
    color: #5865F2;
    margin-right: 4px;
}

.active-label {
    font-size: 11px;
    color: #6B6B6B;
}


/* Sections */
.section {
    margin: 6px 0;
    background-color: #121212;
    border-radius: 3px;
    border-width: 1px;
    border-color: #242424;
    overflow: hidden;
}

.queue-section {
    flex-shrink: 1;
    flex-grow: 0;
    min-height: 80px;
}

.queue-section-has-items {
    flex-grow: 2;
    flex-basis: 0;
}

.history-section {
    flex-grow: 0;
    flex-basis: auto;
    min-height: 80px;
    overflow: hidden;
}

.history-section-has-items {
    flex-grow: 1;
    flex-basis: 0;
}

.section-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background-color: #161616;
    border-bottom-width: 1px;
    border-bottom-color: #242424;
}

.section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #858585;
    letter-spacing: 0.5px;
}

.status-indicator-pulse {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: #5865F2;
}

.clear-button {
    font-size: 11px;
    padding: 3px 8px;
    background-color: transparent;
    border-radius: 3px;
    border-width: 1px;
    border-color: #333333;
    color: #6B6B6B;
}

.clear-button:hover {
    background-color: #2D2D2D;
    color: #858585;
}

/* Scrollable areas */
.queue-scroll, .history-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 6px;
}

.task-list {
    flex-direction: column;
    flex-shrink: 0;
}

/* Empty Messages */
.empty-message {
    padding: 24px 20px;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 0;
}

.empty-icon {
    width: 32px;
    height: 32px;
    margin-bottom: 8px;
    border-radius: 16px;
    background-color: #1A1A1A;
    border-width: 1px;
    border-color: #242424;
}

.empty-text {
    font-size: 13px;
    color: #4B4B4B;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.empty-hint {
    font-size: 11px;
    color: #3A3A3A;
}

/* Task Items */
.task-item {
    flex-direction: column;
    background-color: #161616;
    border-radius: 3px;
    padding: 10px 14px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: #242424;
    border-left-width: 3px;
    border-left-color: #333333;
    overflow: hidden;
    flex-shrink: 0;
}

.task-item:hover {
    background-color: #1A1A1A;
}

.task-active {
    border-left-color: #5865F2;
}

.task-active:hover {
    border-left-color: #7C84F8;
}

.task-completed {
    opacity: 0.8;
}

.task-status-pending {
    border-left-color: #6B6B6B;
}

.task-status-processing {
    border-left-color: #5865F2;
}

.task-status-completed.task-completed {
    border-left-color: #4ADE80;
}

.task-status-failed.task-completed {
    border-left-color: #F87171;
}

.task-status-cancelled.task-completed {
    border-left-color: #6B6B6B;
}

/* Compact History Item Layout */
.task-item-compact {
    padding: 8px 14px;
    margin-bottom: 4px;
}

.task-compact-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    overflow: hidden;
}

.task-compact-left {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    min-width: 0;
}

.task-compact-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    overflow: hidden;
    min-width: 0;
}

.task-prompt-compact {
    font-size: 12px;
    color: #6B6B6B;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.task-compact-right {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
}

/* Allow type label to truncate in compact history items */
.task-item-compact .task-type {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 30px;
}

.task-compact-status {
    font-size: 11px;
    margin-left: 4px;
    white-space: nowrap;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.task-compact-status.status-completed {
    color: #4ADE80;
}

.task-compact-status.status-failed {
    color: #F87171;
}

.task-compact-status.status-cancelled {
    color: #6B6B6B;
}

/* Task Header */
.task-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 8px;
    overflow: hidden;
    flex-shrink: 0;
    min-width: 0;
}

.task-icon {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    margin-right: 6px;
    background-color: #2D2D2D;
}

.task-type-model3d {
    background-color: rgba(88, 101, 242, 0.2);
}

.task-type-voice {
    background-color: rgba(251, 146, 60, 0.2);
}

.task-type-soundeffect {
    background-color: rgba(74, 222, 128, 0.2);
}

.task-type-music {
    background-color: rgba(244, 114, 182, 0.2);
}

.task-type-ambient {
    background-color: rgba(34, 211, 238, 0.2);
}

.task-type {
    font-size: 12px;
    -unity-font-style: bold;
    color: #858585;
    letter-spacing: 0.5px;
    flex-shrink: 0;
    margin-right: 4px;
}

.task-time {
    font-size: 11px;
    color: #4B4B4B;
    -unity-text-align: middle-right;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 40px;
    white-space: nowrap;
    margin-left: auto;
}

/* Task Prompt */
.task-prompt {
    font-size: 13px;
    color: #A3A3A3;
    margin-bottom: 8px;
    white-space: normal;
    overflow: hidden;
    flex-shrink: 0;
}

/* Progress Section */
.task-progress-section {
    flex-direction: column;
    margin-bottom: 4px;
    flex-shrink: 0;
}

.task-progress-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.task-progress-bar {
    flex-grow: 1;
    height: 3px;
    background-color: #1E1E1E;
    border-radius: 2px;
    overflow: hidden;
    margin-right: 8px;
    border-width: 0;
}

.task-progress-fill {
    height: 100%;
    background-color: #5865F2;
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.3s;
}

.task-progress-label {
    font-size: 11px;
    color: #5865F2;
    min-width: 30px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.task-status-message {
    font-size: 11px;
    color: #6B6B6B;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Status Section */
.task-status-section {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.task-status-icon {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 6px;
}

.task-status-icon.status-completed {
    background-color: #4ADE80;
}

.task-status-icon.status-failed {
    background-color: #F87171;
}

.task-status-icon.status-cancelled {
    background-color: #6B6B6B;
}

.task-status-label {
    font-size: 12px;
    letter-spacing: 0.5px;
}

.task-status-label.status-completed {
    color: #4ADE80;
}

.task-status-label.status-failed {
    color: #F87171;
}

.task-status-label.status-cancelled {
    color: #6B6B6B;
}

.task-error-message {
    font-size: 11px;
    color: #F87171;
    margin-top: 4px;
    width: 100%;
    white-space: normal;
}

/* Task Actions */
.task-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

.task-cancel-button {
    font-size: 11px;
    padding: 3px 10px;
    background-color: transparent;
    border-radius: 3px;
    border-width: 1px;
    border-color: #F87171;
    color: #F87171;
}

.task-cancel-button:hover {
    background-color: rgba(248, 113, 113, 0.15);
}

.task-open-button {
    font-size: 11px;
    padding: 2px 8px;
    background-color: transparent;
    border-radius: 3px;
    border-width: 1px;
    border-color: #5865F2;
    color: #5865F2;
    margin-right: 4px;
}

.task-open-button:hover {
    background-color: rgba(88, 101, 242, 0.15);
}

.task-remove-button {
    font-size: 14px;
    width: 20px;
    height: 20px;
    padding: 0;
    background-color: transparent;
    border-radius: 3px;
    border-width: 1px;
    border-color: #333333;
    color: #6B6B6B;
    -unity-text-align: middle-center;
}

.task-remove-button:hover {
    background-color: rgba(248, 113, 113, 0.15);
    border-color: #F87171;
    color: #F87171;
}
