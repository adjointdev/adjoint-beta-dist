/* MCP Setup Window Styles */

/* Root container */
#root-container {
    padding: 20px;
    flex-grow: 1;
}

/* Button container at bottom */
.button-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

/* Button sizing */
.setup-button {
    width: 96px;
}

/* Setup title */
.title {
    font-size: 16px;
}

/* Tips section */
.setup-heading {
    font-size: 14px;
    color: #E4E4E4;
    -unity-font-style: bold;
}

.tip-row {
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: #242424;
}

.tip-label {
    font-size: 12px;
    color: #E4E4E4;
    -unity-font-style: bold;
}

.tip-label-context {
    font-size: 12px;
    color: #5865F2;
    -unity-font-style: bold;
}

.tip-detail {
    -unity-text-align: middle-right;
    color: #6B6B6B;
    white-space: normal;
    flex-shrink: 1;
}
